# 任务板 · 助手配置（格式示例）
#
# 这个文件只是给人看格式用的，.gitignore 只放行它、挡住真正的 .env。
# 实际用法：不用手写 —— 设置页的「助手」里填好接口地址 / 模型名 / 密钥，server.py 会自己写 .env；
# 也可以把这份复制成 .env 再改，或者在设置页里「导入 .env」把内容粘进去。
#
# 注意：.env 里有明文 api key，别外传、别提交。

SPASRE_AGENT_BASE_URL=https://api.deepseek.com/v1
SPASRE_AGENT_MODEL=deepseek-chat
SPASRE_AGENT_API_KEY=
SPASRE_AGENT_REMEMBER_KEY=false
SPASRE_AGENT_ENDPOINT=

# 设置页那道密码门只存派生值，不存原文
SPASRE_AGENT_PASSWORD_HASH=
SPASRE_AGENT_PASSWORD_SALT=
